        <mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.8;fontSize=16;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="snapshot" target="diff">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="PR description" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.8;fontSize=16;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="diff" target="claims">
