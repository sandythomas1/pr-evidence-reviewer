  <diagram id="02" name="02 - Original application architecture">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="boundary" value="" style="rounded=1;arcSize=2;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;dashPattern=8 5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="150" width="1630" height="870" />
        </mxCell>
        <mxCell id="title" value="PR Evidence Reviewer | Original architecture" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="35" width="1610" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="PR-link web application backed by GitHub retrieval, model-based assessment, and evidence reports" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="88" width="1610" height="45" />
        </mxCell>
        <mxCell id="caption0" value="PROPOSED COMPONENTS  /  GITHUB-LINK INPUT IS THE CORE WORKFLOW" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="170" width="1500" height="38" />
        </mxCell>
