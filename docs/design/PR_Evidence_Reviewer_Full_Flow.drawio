            <Array as="points">
              <mxPoint x="345" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge4" value="Code + test evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.8;fontSize=16;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="diff" target="index">
          <mxGeometry as="geometry" relative="1">
